# Local terraform state (can contain secrets)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info

# Variable files that may contain secrets
*.tfvars
*.tfvars.json


# --- Go build output ---
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# binaries built by `go test -c`
*.test
# coverage profiles (go test -coverprofile=coverage.out)
*.out
coverage.*

# The binary `go build` drops in the module folder (named after the module)
/apps/auth-server/server
/apps/auth-server/auth-server

# Go workspace file, usually local-only
go.work
go.work.sum

# Vendored deps (remove this line if you decide to commit vendor/)
/vendor/

# --- Secrets / config (important for Entra ID) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
secrets/
local.settings.json

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Debugging ---
# binaries created by the Delve debugger
__debug_bin*
